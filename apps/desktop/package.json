{
  "name": "@rsagent/desktop",
  "version": "0.0.12",
  "description": "RsAgent macOS Desktop App (Electron shell + rsagentui + rsagent-main)",
  "main": "dist/main.js",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "RsAgent Contributors",
  "scripts": {
    "build": "tsc",
    "dev": "tsc && electron .",
    "pack": "electron-builder --dir",
    "release": "bash scripts/release.sh",
    "release:adhoc": "bash scripts/release.sh --ad-hoc",
    "release:signed": "bash scripts/release.sh --signed",
    "verify:dmg": "bash scripts/verify-dmg.sh",
    "verify:l2": "bash scripts/release-l2.sh",
    "verify:l3": "bash scripts/release-l3.sh",
    "verify:full": "bash scripts/release-verify-all.sh",
    "download-node": "bash scripts/download-node.sh",
    "download-bun": "bash scripts/download-bun.sh",
    "generate-icon": "node scripts/generate-icon.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "tar": "^7.4.3",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@electron/notarize": "^3.0.0",
    "@types/electron": "^1.4.38",
    "@types/node": "^22.0.0",
    "electron": "39.8.10",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.3"
  },
  "author": "RsAgent Contributors"
}
